# Copy to .env for local development. Real environment variables take precedence.

DJANGO_SECRET_KEY=change-me

# Comma-separated. Not needed locally (DEBUG allows localhost); required in production.
# DJANGO_ALLOWED_HOSTS=api.example.com

# Postgres role/database dedicated to this project (see apps/backend/README.md for how they
# were created). Falls back to SQLite at apps/backend/db.sqlite3 when unset.
DATABASE_URL=postgres://rag_chatbot:CHANGE_ME@localhost:5432/rag_chatbot

# Origins allowed to call the API from a browser (the Next.js app).
CORS_ALLOWED_ORIGINS=http://localhost:3000
