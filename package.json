{
  "name": "multi-tenant-rag-chatbot",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant RAG chatbot — Next.js frontend + Django REST Framework backend",
  "workspaces": [
    "apps/frontend"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup:backend": "cd apps/backend && python3 -m venv .venv && .venv/bin/pip install -r requirements/dev.txt && .venv/bin/python manage.py migrate",
    "dev": "concurrently -k -n frontend,backend -c cyan,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "cd apps/backend && .venv/bin/python manage.py runserver",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "npm run lint -w frontend",
    "lint:backend": "cd apps/backend && .venv/bin/ruff check .",
    "lint:fix": "npm run lint:fix -w frontend && cd apps/backend && .venv/bin/ruff check --fix .",
    "typecheck": "npm run typecheck -w frontend",
    "test": "npm run test:backend",
    "test:backend": "cd apps/backend && .venv/bin/pytest",
    "format": "prettier --write . && cd apps/backend && .venv/bin/ruff format .",
    "format:check": "prettier --check . && cd apps/backend && .venv/bin/ruff format --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
